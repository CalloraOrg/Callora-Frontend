# ---------------------------------------------------------------------------
# Callora Frontend - environment configuration
#
# Copy this file to `.env.local` (recommended, git-ignored) or `.env` and
# adjust. Vite only exposes variables prefixed with `VITE_` to the browser
# bundle - anything without that prefix stays build-time only.
#
# `.env.example` is committed on purpose (see the `!.env.example` rule in
# `.gitignore`). Never put real secrets in it: every `VITE_` value is inlined
# into the shipped JavaScript and is readable by anyone who loads the app.
# ---------------------------------------------------------------------------

# --- API access ------------------------------------------------------------

# Base URL the browser uses for Callora API requests.
#
# Leave EMPTY for local development. Requests then stay relative (`/api/...`)
# and the Vite dev server proxies them, so the browser only ever talks to
# http://localhost:5173 and no CORS configuration is needed.
#
# Set an absolute origin (e.g. https://api.staging.callora.com) to bypass the
# proxy and call a deployed backend directly. That origin must allow this app's
# origin via CORS, and must be a full origin with no trailing slash.
VITE_API_BASE_URL=

# --- Stellar ---------------------------------------------------------------

# Stellar network the UI is pointed at. One of: testnet | mainnet | futurenet.
# An unrecognised value falls back to `testnet` and logs a warning in dev.
VITE_STELLAR_NETWORK=testnet

# Soroban RPC endpoint used for wallet deposits. Defaults to the public testnet
# (or futurenet) RPC; mainnet has no default and must be set explicitly.
VITE_STELLAR_RPC_URL=

# Deployed Callora vault contract ID that receives USDC deposits. Deposits
# cannot be submitted until this is set. Must match VITE_STELLAR_NETWORK.
VITE_STELLAR_VAULT_CONTRACT_ID=

# Dev server only: set to `true` to show the deposit demo-outcome toggle.
VITE_ENABLE_DEMO_OUTCOME=false

# --- Dev server only -------------------------------------------------------

# Where the dev server proxies `/api` to (`npm run dev`).
# Read by `vite.config.ts` at startup; never inlined into the browser bundle
# and never used by production builds.
VITE_DEV_API_PROXY_TARGET=http://localhost:3000
